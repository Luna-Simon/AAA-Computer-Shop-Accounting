# =============================================================================
# AAA Computer Services - Accounting Management System
# Environment variables
#
# Copy this file to .env and fill in your values.
# Never commit real credentials, passwords, or secrets to GitHub.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL via Neon - managed provider)
# -----------------------------------------------------------------------------
# Get your connection string from the Neon console.
# Example format:
#   postgres://<user>:<password>@<host>.aws.neon.tech/<dbname>?sslmode=require
#
# LOCAL DEVELOPMENT: Use a local PostgreSQL connection string here.
# PRODUCTION (Vercel): Set this same variable in your Vercel project settings
#   with the production database connection string.
#
# IMPORTANT: Local and production databases are separate. Do not use the same
# database for both environments.
DATABASE_URL="postgres://user:password@localhost:5432/accounting_db?sslmode=require"

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# A secret used to sign session tokens. Generate a strong random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-strong-random-secret"

# URL of your application. For local development use http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Optional: Initial admin account (created on first seed if not present)
# -----------------------------------------------------------------------------
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-in-production"
